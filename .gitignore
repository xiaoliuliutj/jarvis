# ── 依赖 ──────────────────────────────────────────────
node_modules/

# ── 构建产物 ──────────────────────────────────────────
dist/
out/
.vite/
app/web/dl/

# ── 日志 ──────────────────────────────────────────────
*.log
logs/

# ── 配置目录：实际配置不入库，只保留示例模板 ──────────
config/*
!config/*.example.json
!config/*.example.md

# ── 用户数据：会话/记忆/工作区/人设/cron/用户工具 ─────
userdata/

# ── 本地数据备份（含个人数据，不入库） ────────────────
backups/

# ── 历史数据 / 运行时文件 ─────────────────────────────
bridge/config.json
agents/config.json
agents/memory/
agents/tools/_reload.signal
**/*.jsonl

# ── 环境变量文件 ──────────────────────────────────────
.env
.env.*

# ── 系统 / 编辑器 ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# 引用的外部参考书（42MB，不入库）
docs/legacy/deep-dive-claude-code/
